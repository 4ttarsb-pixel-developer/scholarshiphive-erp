# ScholarshipHive ERP v6 — ONE Node.js host + ONE PostgreSQL database (Railway Postgres or Neon)
# Local: copy to .env.  Railway: add these in the service "Variables" tab (see RAILWAY_DEPLOY.md).
NODE_ENV=development
# Railway sets PORT automatically; do not hard-code it there.
PORT=4000
# On Railway, APP_URL defaults to https://$RAILWAY_PUBLIC_DOMAIN when left empty.
APP_URL=http://localhost:4000
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} with DATABASE_SSL=false (private network).
# Neon / Railway DATABASE_PUBLIC_URL: use DATABASE_SSL=true.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SSL=true
# Connection retries at start-up while the database wakes up.
DB_CONNECT_RETRIES=6
COOKIE_SECRET=REPLACE_WITH_96_HEX_CHARACTERS_FROM_npm_run_secret
BUSINESS_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# Marketing Analyzer shares DATABASE_URL; it stores its tables in schema `marketing`.
PERSISTENCE_DRIVER=postgres
DB_SCHEMA=marketing
MARKETING_DB_POOL_MAX=3

# Workforce / Attendance (same DATABASE_URL, schema `workforce`)
WORKFORCE_DB_POOL_MAX=3
WORKFORCE_WEB_SESSION_HOURS=12
WORKFORCE_MOBILE_SESSION_DAYS=30
WORKFORCE_LOGIN_RATE_LIMIT_PER_MINUTE=20
WORKFORCE_API_RATE_LIMIT_PER_MINUTE=300
CHECKOUT_REQUIRES_NETWORK_RULE=true
# Set to the exact trusted proxy hop count (commonly 1 behind one reverse proxy); use false for direct exposure.
TRUST_PROXY=1
TRUST_CLOUDFLARE_HEADER=false

# ERP web / authentication
SESSION_IDLE_MINUTES=30
MAX_ADMINS=3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_DEV_BYPASS=false

# Production: set NODE_ENV=production, the real HTTPS APP_URL and Google OAuth credentials.
# Optional email / WhatsApp integrations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_TEMPLATE_NAME=expense_payment_reminder
WHATSAPP_LANGUAGE_CODE=en

# OPTIONAL tests only: use a separate throw-away PostgreSQL database whose name contains "test". Never use production.
TEST_DATABASE_URL=
