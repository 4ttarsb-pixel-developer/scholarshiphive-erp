{
  "name": "scholarshiphive-erp",
  "version": "1.0.0",
  "private": true,
  "description": "ScholarshipHive ERP — Revenue, Expenses, Petty Cash, Salary, Assets, Liabilities, Cash Flow with roles and Salary & Workforce",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\"",
    "db:setup": "node server/scripts/db-setup.mjs",
    "db:check": "node server/scripts/db-setup.mjs --check",
    "db:reset": "node server/scripts/db-reset.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm ci --prefix client --include=dev --no-audit --no-fund && npm run build --prefix client",
    "start": "node server/src/index.js",
    "test": "node --test --test-concurrency=1 server/tests/api.test.js && npm run test:workforce && npm run test:marketing",
    "marketing:install": "npm install --prefix marketing-backend",
    "marketing:dev": "npm run dev --prefix marketing-backend",
    "test:workforce": "node server/workforce/scripts/test-runner.js",
    "test:marketing": "npm test --prefix marketing-backend",
    "marketing:migrate": "node marketing-backend/src/db/migrate.js",
    "migrate": "node scripts/migrate-all.mjs",
    "build:client": "npm run build --prefix client"
  },
  "dependencies": {
    "@vercel/functions": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "10.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "knex": "3.1.0",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "sql.js": "^1.16.0",
    "supertest": "7.0.0"
  }
}
