{
  "version": 2,
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-PERSISTENT-NODE-API-HOST/api/:path*"
    },
    {
      "source": "/attendance-admin",
      "destination": "https://YOUR-PERSISTENT-NODE-API-HOST/attendance-admin"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
